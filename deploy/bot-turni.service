[Unit]
Description=Bot Turni di Pulizia (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botturni
WorkingDirectory=/home/botturni/bot_turni
ExecStart=/home/botturni/bot_turni/venv/bin/python /home/botturni/bot_turni/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
